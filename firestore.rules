rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write only their own library, notes and progress.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared books. The code is the document id: anyone signed in who knows it can open
    // the share, but shares can't be listed by others. Only the owner can change or delete it.
    match /shares/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Book clubs. The code is the invitation: anyone signed in who knows it can see the club
    // and join it (adding only themselves); members see and add to what's shared. Each
    // member edits only their own notes and comments; the owner can close the club.
    match /clubs/{code} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/clubs/$(code)/members/$(request.auth.uid));
      }
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if isMember();
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
      match /notes/{id} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isMember() && resource.data.authorUid == request.auth.uid;

        match /comments/{comment} {
          allow read: if isMember();
          allow create: if isMember() && request.resource.data.authorUid == request.auth.uid;
          allow delete: if request.auth != null && resource.data.authorUid == request.auth.uid;
        }
      }
    }

    // Highlights shared as links: the same rules as shared books.
    match /quotes/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
