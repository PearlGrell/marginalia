rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write only their own library, notes and progress.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared books. The code is the document id: anyone signed in who knows it can open
    // the share, but shares can't be listed by others. Only the owner can change or delete it.
    match /shares/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Highlights shared as links: the same rules as shared books.
    match /quotes/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
